# ============================================================
# 上传 GitHub 用的忽略规则
# ============================================================
# 原则：**产物可以传，密钥和本人信息绝不传**。
# 加东西前先问一句：这一行泄露出去会不会伤到我？会就加进来。
# ============================================================

# ------------------------------------------------------------
# 1. 签名密钥（最重要）
# ------------------------------------------------------------
# 这是这个 App 的签名私钥，泄露 = 别人可以冒名发布更新。
# keystore-pass.txt 里是它的口令，同样不能传（build-apk.js 从这里或
# 环境变量 GZHU_KS_PASS 读口令，源码里不再写死）。
android/keystore/
*.jks
*.keystore

# ------------------------------------------------------------
# 2. 构建号记录：**不要**忽略，但要知道它的作用
# ------------------------------------------------------------
# android/build-number.json 是故意**提交**的：它保证 versionCode 单调递增，
# 删掉会导致编号从 1 重来、手机上无法覆盖安装。别把它加进忽略列表。
# （这里写出来只是提醒，不是规则。）

# ------------------------------------------------------------
# 3. Android SDK（几百 MB，本机装的，别人自己装）
# ------------------------------------------------------------
android/sdk/

# ------------------------------------------------------------
# 4. 构建中间产物与验证输出
# ------------------------------------------------------------
android/build/
android/out/_chrome-profile/
android/**/_stdout.log
android/**/_stderr.log
android/**/_*.log
android/out/*.idsig

# APK 不进仓库，改由 GitHub Releases 分发。
# 理由：APK 是构建产物，二进制文件塞进 git 会让仓库随每次发版持续膨胀，
# 而且 git 对二进制没法有效增量存储——几十个版本下来仓库就是几百 MB。
# 构建脚本每次只在 out/ 保留最新一份（见 build-apk.js 第 11 步），
# 本地随时能拿到；要发布就上传到 Release。
android/out/*.apk
android/dl/

# ------------------------------------------------------------
# 5. 逆向/抓取产物
# ------------------------------------------------------------
# recon/ 是当初抓学校系统时的样本与脚本：里面有真实的响应数据，
# 包含本人学号、以及**其他同学和老师的姓名**（课程表里的 JSXM/XM 字段）。
# 这些不是我的信息，不该由我公开。仓库里不放，需要时本地留着即可。
recon/

# ------------------------------------------------------------
# 5.5 开发期的临时脚本与产物（本地保留，不进仓库）
# ------------------------------------------------------------
# 这些都是"当时为了查一个问题"写的一次性脚本。对使用者没有价值，
# 留在仓库里只会让人以为要跑它们。本机继续留着以备复查。

# 一次性调试程序（不是跑得起来的回归测试）
android/test/DiagTest.java
android/test/RouterDebug.java
android/test/ShellDebug.java
android/test/Direct.java
android/test/CookieDump.java
android/test/DesTrace.java
android/test/EncTrace.java
android/test/SboxTrace.java
android/test/UrlTest.java
android/test/SequenceTest.java
android/test/WarmTest.java

# 当初装 Android SDK 用的引导脚本（SDK 本身也在 .gitignore 里）
# 使用者照 README 自己装 sdkmanager 即可，不需要这两个
android/sdk-install.js
android/sdk-list.js

# server/ 的早期验证脚本与截图（那时还没有 preview.js）
server/shot.js
server/shot_*.png
server/test_out.json
server/test-client.js

# ------------------------------------------------------------
# 6. 本地凭据（如果以后加了这类文件）
# ------------------------------------------------------------
.env
.env.*
*.local
credentials.json

# ------------------------------------------------------------
# 7. 编辑器与系统杂项
# ------------------------------------------------------------
.vscode/
.idea/
*.iml
Thumbs.db
Desktop.ini
.DS_Store

# ------------------------------------------------------------
# 8. 临时文件
# ------------------------------------------------------------
*.tmp
*.bak
*~
